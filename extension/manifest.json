{
  "manifest_version": 3,
  "name": "Shopee Avaliações — Controle Inteligente",
  "version": "7.0.0",
  "description": "Avaliações 5 estrelas com triagem de reclamações, monitoramento por eventos de interface, intervalo padrão 2s, bloqueio de duplicatas e meta de 50 a 1000 respostas confirmadas.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://seller.shopee.com.br/*",
    "https://seller.shopee.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://seller.shopee.com.br/*",
        "https://seller.shopee.com/*"
      ],
      "js": [
        "shared.js",
        "content.js",
        "automation.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Shopee Avaliações — Revisão",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
